<!DOCTYPE html>
<html>
<head>
  <title><%= event ? 'Edit event' : 'New event' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('nav') %>
  <div class="container mt-4" style="max-width: 500px;">
    <h1><%= event ? 'Edit event' : 'New event' %></h1>
    <form method="POST" action="<%= event ? '/admin/events/' + event.id + '/edit' : '/admin/events' %>">
      <input class="form-control mb-3" name="title" placeholder="Title" required
             value="<%= event ? event.title : '' %>">
      <textarea class="form-control mb-3" name="description" placeholder="Description"><%= event ? event.description : '' %></textarea>
      <input class="form-control mb-3" type="datetime-local" name="event_date" required
             value="<%= dateValue %>">
      <input class="form-control mb-3" type="number" step="0.01" min="0" name="price" placeholder="Price" required
             value="<%= event ? event.price : '' %>">
      <h6>Extra per row (PLN, added to the price)</h6>
      <div class="row g-2 mb-3">
        <% for (let r = 1; r <= rowCount; r++) { %>
          <div class="col-4">
            <label class="form-label small mb-0" for="extra<%= r %>">Row <%= r %></label>
            <input class="form-control form-control-sm" type="number" step="0.01" min="0"
                   id="extra<%= r %>" name="extra_<%= r %>" value="<%= extras[r] || 0 %>">
          </div>
        <% } %>
      </div>
      <select class="form-select mb-3" name="arena_id" required>
         <% arenas.forEach(a => { %>
            <option value="<%= a.id %>" <%= event && event.arena_id === a.id ? 'selected' : '' %>><%= a.name %></option>
         <% }) %> 
      </select>
      <button class="btn btn-primary">Save</button>
      <a href="/events" class="btn btn-link">Cancel</a>
    </form>
  </div>
</body>
</html>