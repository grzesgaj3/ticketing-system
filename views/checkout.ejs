<!DOCTYPE html>
<html>
<head>
  <title>Checkout</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('nav') %>
  <div class="container mt-4" style="max-width: 600px;">
    <h1>Checkout</h1>
    <h5><%= event.title %></h5>
    <ul class="list-group mb-3">
      <% seats.forEach(seat => { %>
        <li class="list-group-item d-flex justify-content-between">
          <span>Section <%= seat.section %>, row <%= seat.row_num %>, seat <%= seat.seat_number %></span>
          <span><%= event.price %> PLN</span>
        </li>
      <% }) %>
      <% if (floor > 0) { %>
        <li class="list-group-item d-flex justify-content-between">
          <span>Floor (standing) × <%= floor %></span>
          <span><%= (Number(event.price) * floor).toFixed(2) %> PLN</span>
        </li>
      <% } %>
      <li class="list-group-item d-flex justify-content-between fw-bold">
        <span>Total</span><span><%= total %> PLN</span>
      </li>
    </ul>

    <form method="POST" action="/events/<%= event.id %>/book">
      <% seats.forEach(seat => { %>
        <input type="hidden" name="seats" value="<%= seat.id %>">
      <% }) %>
      <input type="hidden" name="floor" value="<%= floor %>">
      <button class="btn btn-success">Pay (simulated)</button>
      <a href="/events/<%= event.id %>/seats" class="btn btn-link">Back</a>
    </form>
  </div>
</body>
</html>