<!DOCTYPE html>
<html>
<head>
  <title>All orders</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('nav') %>
  <div class="container mt-4">
    <h1>All orders</h1>
    <table class="table">
      <thead>
        <tr><th>#</th><th>User</th><th>Event</th><th>Seats</th><th>Total</th><th>Date</th><th></th></tr>
      </thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr>
            <td><%= o.id %></td>
            <td><%= o.email %></td>
            <td><%= o.title %></td>
            <td><%= o.seats %></td>
            <td><%= o.total %> PLN</td>
            <td><%= o.created_at.toLocaleString('pl-PL') %></td>
            <td>
              <form method="POST" action="/admin/orders/<%= o.id %>/cancel"
                    onsubmit="return confirm('Cancel order #<%= o.id %>?')">
                <button class="btn btn-outline-danger btn-sm">Cancel</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>