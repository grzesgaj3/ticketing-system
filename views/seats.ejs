<!DOCTYPE html>
<html>
<head>
  <title>Choose seats</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('nav') %>
  <div class="container mt-4">
    <h1><%= event.title %></h1>
    <p>Green = free, grey = taken. Click seats to select them.</p>

    <form method="POST" action="/events/<%= event.id %>/checkout">
      <% Object.entries(sections).forEach(([section, rows]) => { %>
        <h5 class="mt-4">Section <%= section %></h5>
        <% Object.entries(rows).forEach(([rowNum, rowSeats]) => { %>
          <div class="mb-1">
            <span class="d-inline-block" style="width: 60px;">Row <%= rowNum %></span>
            <% rowSeats.forEach(seat => { %>
              <input type="checkbox" class="btn-check" name="seats"
                     value="<%= seat.id %>" id="seat<%= seat.id %>"
                     <%= seat.taken ? 'disabled' : '' %>>
              <label class="btn btn-sm <%= seat.taken ? 'btn-secondary' : 'btn-outline-success' %>"
                     for="seat<%= seat.id %>"><%= seat.seat_number %></label>
            <% }) %>
          </div>
        <% }) %>
      <% }) %>
      <button class="btn btn-primary mt-4">Continue to checkout</button>
    </form>
  </div>
</body>
</html>