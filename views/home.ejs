<!DOCTYPE html>
<html>
<head>
  <title>Tickets</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .hero {
      background: linear-gradient(135deg, #1e1b4b, #7c3aed 60%, #ec4899);
      color: white;
      padding: 100px 0;
    }
    .feature-icon {
      font-size: 3rem;
    }
  </style>
</head>
<body>
  <%- include('nav') %>

  <section class="hero text-center">
    <div class="container">
      <h1 class="display-3 fw-bold">Your next event starts here</h1>
      <p class="lead my-4">Concerts, shows and live nights. Pick your exact seat and book in a few clicks.</p>
      <a href="/events" class="btn btn-light btn-lg me-2">Browse events</a>
      <% if (!user) { %>
        <a href="/register" class="btn btn-outline-light btn-lg">Create account</a>
      <% } %>
    </div>
  </section>

  <section class="container py-5">
    <div class="row text-center g-4">
      <div class="col-md-4">
        <div class="feature-icon">🎤</div>
        <h4 class="mt-3">Find your event</h4>
        <p class="text-muted">Browse upcoming concerts and shows with dates and prices.</p>
      </div>
      <div class="col-md-4">
        <div class="feature-icon">💺</div>
        <h4 class="mt-3">Pick your seats</h4>
        <p class="text-muted">See the arena, check which seats are free and choose exactly where you sit.</p>
      </div>
      <div class="col-md-4">
        <div class="feature-icon">🎟️</div>
        <h4 class="mt-3">Book instantly</h4>
        <p class="text-muted">Confirm your order and find your tickets under My orders.</p>
      </div>
    </div>
  </section>
</body>
</html>