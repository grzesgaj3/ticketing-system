<!DOCTYPE html>
<html>
<head>
  <title><%= event ? 'Edit event' : 'New event' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('nav') %>
  <div class="container mt-4" style="max-width: 500px;">
    <h1><%= event ? 'Edit event' : 'New event' %></h1>
    <form method="POST" action="<%= event ? '/admin/events/' + event.id + '/edit' : '/admin/events' %>">
      <input class="form-control mb-3" name="title" placeholder="Title" required
             value="<%= event ? event.title : '' %>">
      <textarea class="form-control mb-3" name="description" placeholder="Description"><%= event ? event.description : '' %></textarea>
      <input class="form-control mb-3" type="datetime-local" name="event_date" required
             value="<%= dateValue %>">
      <input class="form-control mb-3" type="number" step="0.01" min="0" name="price" placeholder="Price" required
             value="<%= event ? event.price : '' %>">
      <button class="btn btn-primary">Save</button>
      <a href="/" class="btn btn-link">Cancel</a>
    </form>
  </div>
</body>
</html>