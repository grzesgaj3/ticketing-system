<!DOCTYPE html>
<html>
<head>
  <title><%= event.title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('nav') %>
  <div class="container mt-4">
    <a href="/">&larr; All events</a>
    <h1 class="mt-3"><%= event.title %></h1>
    <p><%= event.event_date.toLocaleString('pl-PL') %></p>
    <p><%= event.description %></p>
    <p class="fw-bold"><%= event.price %> PLN per seat</p>
    <a href="/events/<%= event.id %>/seats" class="btn btn-success">Choose seats</a>
  </div>
</body>
</html>